{
  "name": "war-battalion-game",
  "version": "1.0.0",
  "private": true,
  "description": "Battalion Command: The Kazan Front - a 3D browser war strategy game about commanding battalions on a moving front line.",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --sourcemap --format=iife --target=es2020 --outfile=dist/game.js",
    "dev": "esbuild src/main.js --bundle --sourcemap --format=iife --target=es2020 --outfile=dist/game.js --watch=forever --servedir=. --serve=8080"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
